{
  "name": "galabet-fair",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=18.17"
  },
  "pnpm": {
    "overrides": {
      "fastify": "^4.29.1"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:props": "turbo run test:props",
    "vectors:gen": "node --import tsx scripts/gen-vectors.ts",
    "vectors:check": "node --import tsx scripts/gen-vectors.ts --check",
    "dev:api": "pnpm --filter api start:dev",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@types/node": "^22.7.5",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "tsup": "^8.3.0",
    "tsx": "^4.19.1",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
