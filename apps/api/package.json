{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "description": "Galabet Fair API: verify, demo seeds, badge, vectors, registry, notary. NestJS on Fastify.",
  "type": "commonjs",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "worker": "node dist/worker.js",
    "worker:dev": "nest start --entryFile worker --watch --path tsconfig.worker.json",
    "start:prod": "node dist/main.js",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "test": "node --require ./test/register-ts.cjs --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.1.2",
    "@fastify/helmet": "^11.1.1",
    "@galabet/fair": "workspace:*",
    "@nest-lab/throttler-storage-redis": "^1.0.0",
    "bullmq": "^5.13.0",
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-fastify": "^10.4.4",
    "@nestjs/platform-ws": "^10.4.4",
    "@nestjs/websockets": "^10.4.4",
    "@nestjs/throttler": "^6.2.1",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.0",
    "fastify": "^4.29.1",
    "ioredis": "^5.4.1",
    "nodemailer": "^6.9.15",
    "pg": "^8.13.0",
    "pino-pretty": "^11.2.2",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "@sentry/node": "^8.33.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@types/node": "^22.7.5",
    "@types/nodemailer": "^6.4.16",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.12",
    "drizzle-kit": "^0.27.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
