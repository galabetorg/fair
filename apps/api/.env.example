NODE_ENV=development
PORT=3000
HOST=0.0.0.0

DATABASE_URL=postgres://fair:fair@localhost:5432/fair
REDIS_URL=redis://localhost:6379

# Public site origin, for CORS
SITE_ORIGIN=http://localhost:4321

# Cloudflare Turnstile. Leave empty in development to disable the check.
TURNSTILE_SECRET=

# Ed25519 private key (hex) the notary signs receipts with. Batch 3.
NOTARY_SIGNING_KEY=

# Beacons. Batch 3.
BEACON_DRAND_URL=https://api.drand.sh
BEACON_EVM_RPC=https://bsc-dataseed.binance.org

# Demo seeds: how long a browser session's seed pair lives, seconds
DEMO_SESSION_TTL=86400
# Max new demo sessions per IP per day
DEMO_SESSIONS_PER_IP_PER_DAY=30
# Where gfs-1.0.json lives. Empty = <repo>/vectors
VECTORS_DIR=
# Set to off to run the worker without the crash round loop
CRASH_ENGINE=on

# Admin API bearer token. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=
# Optional error tracking
SENTRY_DSN=
# Optional SMTP for operator emails, e.g. smtp://user:pass@smtp.eu.mailgun.org:587
SMTP_URL=
MAIL_FROM=Galabet Fair <no-reply@galabets.org>
# true on managed Postgres with TLS
DATABASE_SSL=false
# Virtual chips a demo session starts with
DEMO_START_CHIPS=1000
