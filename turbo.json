{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", ".astro/**"] },
    "test": { "dependsOn": ["build"] },
    "test:props": { "dependsOn": ["build"] },
    "dev": { "cache": false, "persistent": true },
    "start:dev": { "cache": false, "persistent": true }
  }
}
